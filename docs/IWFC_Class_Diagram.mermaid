classDiagram

%% Interfaces
class Identifiable {
    <<interface>>
    +getId() String
}

class PaymentStrategy {
    <<interface>>
    +processPayment(PaymentContext) PaymentResult
}

class Repository~T~ {
    -items: List~T~
    +add(T)
    +update(T)
    +remove(String)
    +findById(String) T
    +findAll() List~T~
}

%% Abstract Base Classes
class User {
    <<abstract>>
    -userId: String
    -name: String
    -email: String
    -role: Role
}

class FitnessPlan {
    <<abstract>>
    -id: String
    -title: String
    -baseMonthlyFee: double
    +calculateTotalCost() double*
    +getProgressionSummary() String*
    +getPlanType() String*
}

%% Core Entities
class Member {
    -membershipType: String
    -hoursSpent: double
}

class Instructor {
    -specialization: String
    -performanceScore: double
}

class Admin {
    -accessLevel: String
}

class Equipment {
    -id: String
    -name: String
    -status: EquipmentStatus
    +logUsage(double)
    +needsMaintenance() boolean
}

class FitnessSession {
    -id: String
    -name: String
    -capacity: int
}

class MaintenanceRequest {
    -id: String
    -description: String
    -status: RequestStatus
}

class Enrollment {
    -id: String
    -memberId: String
    -planId: String
    -instructorId: String
}

%% Inheritance
Identifiable <|-- User
Identifiable <|-- Equipment
Identifiable <|-- FitnessSession
Identifiable <|-- MaintenanceRequest
Identifiable <|-- FitnessPlan
Identifiable <|-- Enrollment

User <|-- Member
User <|-- Instructor
User <|-- Admin

FitnessPlan <|-- GroupClassPlan
FitnessPlan <|-- PersonalTrainingPlan
FitnessPlan <|-- SelfGuidedPlan

%% Associations
Equipment "1" <-- "0..*" MaintenanceRequest : concerns
Instructor "1" <-- "0..*" MaintenanceRequest : reports
FitnessSession "1" *-- "0..*" Booking : contains
Member "1" <-- "0..*" Booking : makes
Member "1" <-- "0..*" Enrollment : has
FitnessPlan "1" <-- "0..*" Enrollment : references

%% System Facade
class IWFCSystemFacade {
    -equipmentService: EquipmentService
    -sessionService: SessionService
    -maintenanceService: MaintenanceService
    -paymentService: PaymentService
    -userService: UserService
    -enrollmentService: EnrollmentService
    +login(String) User
    +bookSession(String) Booking
    +reportMaintenance(...)
}

IWFCSystemFacade --> EquipmentService
IWFCSystemFacade --> SessionService
IWFCSystemFacade --> MaintenanceService
IWFCSystemFacade --> PaymentService
IWFCSystemFacade --> UserService
IWFCSystemFacade --> EnrollmentService
